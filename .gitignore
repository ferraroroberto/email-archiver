# Local config (copy from config.example.yaml)
config/config.yaml
# Machine-local mailbox registry: personal addresses (copy from mailboxes.sample.json)
config/mailboxes.json

# Database and logs
data/*.db
data/*.db-shm
data/*.db-wal
# Manual database backups (e.g. emails.db.bak-20260909-0513)
data/*.bak*
logs/*.log
__pycache__/
*.pyc
*.pyo
.venv/
venv/
tmp/
# Launcher scratch (ephemeral images/logs written by the tray launcher)
.launcher-tmp/
